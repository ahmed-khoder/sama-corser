# ===================================================
# SAMA Logistics — ملف متغيرات بيئة الإنتاج (Production)
# قم بنسخ هذا الملف إلى .env على السيرفر:
# cp .env.production.example .env
# ===================================================

# ── 1. منفذ تشغيل التطبيق (Port) ──
# المنفذ الذي سيستمع عليه التطبيق على السيرفر الخارجي (يمكنك ربطه بـ Nginx Proxy Manager)
PORT=3030

# ── 2. قاعدة البيانات (Database) ──
# مسار قاعدة بيانات SQLite الدائمة داخل الحاوية (لا تغيره إلا إذا كنت تستخدم PostgreSQL)
DATABASE_URL=file:/data/db/dev.db

# ── 3. مفتاح الأمان والتشفير (JWT Secret) ──
# هام جداً: غيّر هذه القيمة لسلسلة عشوائية قوية من 32 حرفاً على الأقل!
# يمكنك توليد قيمة عشوائية بتنفيذ الأمر: openssl rand -base64 32
JWT_SECRET=sama-production-super-secret-key-change-this-now

# ── 4. روابط الموقع والدومين (Site URLs) ──
# الرابط الأساسي للموقع من منظور المتصفح والزوار (الذي قمت بتعيينه في Nginx Proxy Manager)
# مثال: https://samalogistics.com أو http://your-server-ip:3030
NEXT_PUBLIC_SITE_URL=https://samalogistics.com
NEXT_PUBLIC_BASE_URL=https://samalogistics.com

# ── 5. تكامل نظام Odoo ERP (اختياري) ──
ODOO_URL=https://your-odoo-instance.odoo.com
ODOO_DB=your-odoo-db
ODOO_USERNAME=your-odoo-username
ODOO_PASSWORD=your-odoo-password

# ── 6. إعدادات محركات البحث وتحليلات جوجل (اختياري) ──
# كود التحقق من ملكية الموقع في Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# معرف إحصائيات جوجل (Google Analytics GA4)
# NEXT_PUBLIC_GA_ID=G-33C7XZ028K
